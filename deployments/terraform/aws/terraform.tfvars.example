# Sample Terraform Variables for AWS Deployment
aws_region            = "us-east-1"
environment           = "prod"
instance_type         = "t4g.xlarge"   # Graviton3 ARM64 (4 vCPU, 16GB RAM)
ebs_volume_size       = 200            # GP3 200GB SSD
min_cluster_size      = 2
max_cluster_size      = 5
spot_price_percentage = 70             # 70% Spot / 30% On-Demand for 60-70% cost savings
redis_node_type       = "cache.t4g.small"

# Upstream RPCs
eth_l1_rpc_url  = "https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
polygon_rpc_url = "https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
