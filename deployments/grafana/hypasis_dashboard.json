{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Node Sync Status",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hypasis_sync_status",
          "legendFormat": "Sync State",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "title": "Active DevP2P Peers",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hypasis_p2p_active_peers",
          "legendFormat": "Peers",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "title": "Storage Throughput (RPS)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(hypasis_storage_operations_total[1m])",
          "legendFormat": "Ops/sec",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "title": "L1 RootChain Stake Ratio",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hypasis_l1_verified_stake_ratio",
          "legendFormat": "Stake %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "title": "Polygon Block Tip vs L1 Checkpoint Anchor Height",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hypasis_sync_block_number{type=\"forward_tip\"}",
          "legendFormat": "Forward Tip",
          "refId": "A"
        },
        {
          "expr": "hypasis_sync_block_number{type=\"l1_checkpoint\"}",
          "legendFormat": "L1 Checkpoint Anchor",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "title": "Storage Read/Write Latency (p50, p95, p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(hypasis_storage_latency_seconds_bucket[1m]))",
          "legendFormat": "p50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(hypasis_storage_latency_seconds_bucket[1m]))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(hypasis_storage_latency_seconds_bucket[1m]))",
          "legendFormat": "p99 Latency",
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hypasis", "sync", "polygon", "blockchain"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Hypasis Sync Protocol - Production Monitoring Dashboard",
  "version": 1
}
